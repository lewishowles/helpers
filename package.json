{
	"name": "@lewishowles/helpers",
	"version": "1.7.1",
	"description": "A library of gorgeous Javascript methods to make working with—and validating—data quicker and less error-prone, letting the developer concentrate on the fun stuff.",
	"keywords": [
		"array",
		"date",
		"form",
		"helpers",
		"javascript",
		"object",
		"string",
		"utilities",
		"validation",
		"vue"
	],
	"homepage": "https://github.com/lewishowles/helpers#readme",
	"bugs": "https://github.com/lewishowles/helpers/issues",
	"license": "MIT",
	"author": "Lewis Howles",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lewishowles/helpers.git"
	},
	"files": [
		"CHANGELOG.md",
		"dist",
		"types"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#array/*": "./lib/array/*.js",
		"#date/*": "./lib/date/*.js",
		"#form/*": "./lib/form/*.js",
		"#general/*": "./lib/general/*.js",
		"#number/*": "./lib/number/*.js",
		"#object/*": "./lib/object/*.js",
		"#string/*": "./lib/string/*.js",
		"#url/*": "./lib/url/*.js",
		"#vue/*": "./lib/vue/*.js"
	},
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./dist/index.js"
		},
		"./array": {
			"types": "./types/array.d.ts",
			"import": "./dist/array.js"
		},
		"./date": {
			"types": "./types/date.d.ts",
			"import": "./dist/date.js"
		},
		"./form": {
			"types": "./types/form.d.ts",
			"import": "./dist/form.js"
		},
		"./general": {
			"types": "./types/general.d.ts",
			"import": "./dist/general.js"
		},
		"./number": {
			"types": "./types/number.d.ts",
			"import": "./dist/number.js"
		},
		"./object": {
			"types": "./types/object.d.ts",
			"import": "./dist/object.js"
		},
		"./string": {
			"types": "./types/string.d.ts",
			"import": "./dist/string.js"
		},
		"./vue": {
			"types": "./types/vue.d.ts",
			"import": "./dist/vue.js"
		},
		"./url": {
			"types": "./types/url.d.ts",
			"import": "./dist/url.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vp dev",
		"test:unit": "vp test",
		"test:unit:run": "vp test run",
		"build": "vp pack",
		"preview": "vp preview",
		"lint": "vp check",
		"lint:fix": "vp check --fix",
		"docs:readme": "node support/generate-readme.js",
		"check:exports": "pkg-checks exports . --config quality.config.json",
		"check:package-size": "pkg-checks size . --config quality.config.json",
		"check:packed-imports": "support/check-packed-imports.sh",
		"check:readme": "support/check-readme.sh",
		"check:runtime-deps": "pkg-checks runtime-deps . --config quality.config.json",
		"check:test-coverage": "pkg-checks test-coverage .",
		"check:type-declarations": "pkg-checks type-declarations .",
		"helpers:search": "support/search-helpers.js",
		"publint": "publint",
		"attw": "support/check-attw.sh",
		"check:all": "support/run-all-checks.sh"
	},
	"dependencies": {
		"dayjs": "^1.11.23",
		"temporal-polyfill": "^1.0.5"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@lewishowles/cli-style": "^0.16.0",
		"@lewishowles/lint-config": "^0.8.0",
		"@lewishowles/pkg-checks": "^0.2.4",
		"@stylistic/eslint-plugin": "^5.10.0",
		"globals": "^17.13.0",
		"happy-dom": "^20.14.5",
		"publint": "^0.3.25",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
		"vite-plus": "1.0.0",
		"vue": "^3.5.43"
	},
	"peerDependencies": {
		"vue": "^3.5.39"
	},
	"peerDependenciesMeta": {
		"vue": {
			"optional": true
		}
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
		"vitest": "5.0.1"
	},
	"engines": {
		"node": ">=20"
	}
}
